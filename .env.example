# Optional custom public origin. Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=https://mahjong.example.com

# Comma-separated extra browser origins allowed to connect to Socket.IO.
ALLOWED_ORIGINS=https://mahjong.example.com

# Persistent runtime state directory. Render uses /var/data.
DATA_DIR=./data

PORT=3000
HOST=0.0.0.0
